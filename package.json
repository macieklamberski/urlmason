{
  "name": "urlmason",
  "description": "Turn URLs into values and values back into URLs, from one table of URL templates.",
  "repository": {
    "type": "git",
    "url": "https://github.com/macieklamberski/urlmason.git"
  },
  "bugs": {
    "url": "https://github.com/macieklamberski/urlmason/issues"
  },
  "license": "MIT",
  "author": "Maciej Lamberski",
  "sideEffects": false,
  "keywords": [
    "url",
    "uri-template",
    "rfc6570",
    "parse",
    "build",
    "match",
    "alias"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsdown src/index.ts --format esm --dts --clean --unbundle"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "kvalita": "^1.41.0",
    "trousse": "3.17.0",
    "tsdown": "0.23.7"
  }
}
